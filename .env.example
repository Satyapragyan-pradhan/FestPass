# ==============================================================================
# FestPass Environment Variables Template (.env.example)
# ==============================================================================
# Run "npm run keygen" to automatically generate Ed25519 keys and a working .env!
# ==============================================================================

# Node Identity & Network Configuration
PORT=4001
NODE_ID=B1
NODE_ROLE=booth
# NODE_ROLE options:
#   - booth: Issues tickets, holds Ed25519 private key + public key (Ports 4001-4003)
#   - gate:  Validates entries, holds Ed25519 public key only (Ports 4004-4006)
#   - both:  Combined role for single-node development or testing

# Snowflake Node Index (0-1023)
# Node indices: B1=1, B2=2, B3=3, G1=4, G2=5, G3=6
NODE_INDEX=1

# SQLite storage directory (Each node maintains an isolated data/<NODE_ID>.db)
DATA_DIR=./data

# Authentication & Logging
JWT_SECRET=festpass-stage1-super-secret-jwt-key-2026
LOG_LEVEL=info

# Cryptographic Keys (Ed25519)
# Generate via: npm run keygen
# Or keep in files keys/ed25519-private.pem and keys/ed25519-public.pem
# Booth nodes require PRIVATE key; Gate nodes require PUBLIC key.
ED25519_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
ED25519_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Cluster Topology (Comma-separated NODE_ID=URL mappings)
PEERS="B1=http://localhost:4001,B2=http://localhost:4002,B3=http://localhost:4003,G1=http://localhost:4004,G2=http://localhost:4005,G3=http://localhost:4006"
